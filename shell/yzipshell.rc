// Version resource of the shell extension; build\version.h is generated from version.py.
#include <winver.h>
#include "build\version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION YZ_VER
 PRODUCTVERSION YZ_VER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yzip"
            VALUE "FileDescription", "yzip Explorer context menu"
            VALUE "FileVersion", YZ_VER_STR
            VALUE "InternalName", "yzipshell"
            VALUE "LegalCopyright", "Copyright (c) 2026 MrDH1004. MIT License."
            VALUE "OriginalFilename", "yzipshell.dll"
            VALUE "ProductName", "yzip"
            VALUE "ProductVersion", YZ_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
